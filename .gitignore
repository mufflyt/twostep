# Private EC2/S3 infrastructure values (copy scripts/ec2.env.example -> scripts/ec2.env)
scripts/ec2.env

# R / RStudio
.Rproj.user/
.Rhistory
.RData
.Ruserdata
*.Rproj
.Renviron
# NOTE: .Rprofile is tracked on purpose — renv writes `source("renv/activate.R")`
# there so the pinned library auto-activates. Do not ignore it.

# rmarkdown render byproducts (intermediates only). The canonical rendered
# manuscript (manuscript/e2sfca_accessibility_manuscript.html) IS committed as the
# deliverable; dated/other variants stay ignored.
manuscript/*_files/
manuscript/*_cache/
manuscript/*.knit.md
manuscript/e2sfca_accessibility_manuscript_*.html

# OS
.DS_Store

# renv (if initialized later)
renv/library/
renv/local/
renv/cellar/
renv/lock/
.mutation-corpus-in-progress

# Rendered manuscript outputs -- build products, not sources.
# `Rscript render.R` regenerates the HTML from the Rmd plus the
# checksum-verified frozen artifacts; `Rscript render_docx.R` converts it.
# They weigh ~20MB together, so tracking them meant a 20MB binary diff on every
# render. Published as RELEASE ASSETS instead; see
# .github/workflows/release-manuscript.yml.
manuscript/e2sfca_accessibility_manuscript.html
# Lightweight review copy: the full HTML with its 8 base64-embedded figures
# replaced by placeholders (9.6 MB -> 0.75 MB) so it fits an upload limit.
# Derived and regenerable; not a source document.
manuscript/manuscript_review_copy.html
manuscript/e2sfca_accessibility_manuscript.docx

# R CMD check output
twostep.Rcheck/
*.tar.gz
pl_pfile_20050523-20260809.csv

# Generated pkgdown site. Deployed to gh-pages, never committed to main.
pkgdown-site/

# Derived ACS cache written by scripts/sensitivity_e2sfca_2020.R (56 MB)
artifacts/2sfca/sensitivity/cache/

# CI accounting written by the nightly testthat job
artifacts/ci/

# Age-matched panel working set: per-year supply extracted from the frozen-run
# tarball, and per-vintage ACS caches. Derived and large; the tarball and the
# Census API are the sources.
# Derived working set only: the per-cell supply files extracted from the frozen
# run's tarball. The PANEL ITSELF is the deliverable and is tracked -- an earlier
# blanket ignore of this directory would have kept the corrected 154-row result
# out of the repository entirely.
artifacts/2sfca/agematched_panel/sup/
artifacts/2sfca/agematched_panel/ec2/
artifacts/2sfca/sensitivity/cache/

# The frozen isochrone set (1.4 GB across four bands). Content is pinned by
# inst/multiverse/frozen_isochrones.sha256 and the authoritative copy lives at
# s3://tyler-valhalla-tiles/seam_run/inputs/isochrones/ -- the bytes do not
# belong in git, but the hashes do, so tools/ci/check_frozen_isochrones.sh can
# prove whichever copy is on disk is the right one.
artifacts/2sfca/frozen_isochrones/

# Pinned RUCA payload: fetched from S3 and hash-verified by
# tools/multiverse/resolve_ruca.sh. Only inst/multiverse/ruca_inputs.json ships.
artifacts/2sfca/ruca/
