# Private EC2/S3 infrastructure values (copy scripts/ec2.env.example -> scripts/ec2.env)
scripts/ec2.env

# R / RStudio
.Rproj.user/
.Rhistory
.RData
.Ruserdata
*.Rproj
.Renviron
# NOTE: .Rprofile is tracked on purpose — renv writes `source("renv/activate.R")`
# there so the pinned library auto-activates. Do not ignore it.

# rmarkdown render byproducts (intermediates only). The canonical rendered
# manuscript (manuscript/e2sfca_accessibility_manuscript.html) IS committed as the
# deliverable; dated/other variants stay ignored.
manuscript/*_files/
manuscript/*_cache/
manuscript/*.knit.md
manuscript/e2sfca_accessibility_manuscript_*.html

# OS
.DS_Store

# renv (if initialized later)
renv/library/
renv/local/
renv/cellar/
renv/lock/
.mutation-corpus-in-progress

# Rendered manuscript outputs -- build products, not sources.
# `Rscript render.R` regenerates the HTML from the Rmd plus the
# checksum-verified frozen artifacts; `Rscript render_docx.R` converts it.
# They weigh ~20MB together, so tracking them meant a 20MB binary diff on every
# render. Published as RELEASE ASSETS instead; see
# .github/workflows/release-manuscript.yml.
manuscript/e2sfca_accessibility_manuscript.html
manuscript/e2sfca_accessibility_manuscript.docx

# R CMD check output
twostep.Rcheck/
*.tar.gz
pl_pfile_20050523-20260809.csv
