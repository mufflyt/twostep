# scripts/ec2.env.example -- template for private EC2/S3 infrastructure values.
#
# The ec2_run_*.sh launchers are provenance/reproduction tooling for the author's
# AWS account. To run them, copy this file to scripts/ec2.env (which is gitignored)
# and fill in your own values, or export the same variables in your shell.
#
#   cp scripts/ec2.env.example scripts/ec2.env   # then edit scripts/ec2.env
#
# None of these are secrets (auth is via an IAM instance profile, not embedded
# keys), but they identify private infrastructure, so they are kept out of the
# public repo. The launchers fail loudly on the CHANGEME-* placeholder defaults.

export EC2_REGION="us-east-2"                    # generic AWS region (not sensitive)
export S3_BUCKET="CHANGEME-tiles-bucket"         # your Valhalla-tiles / transport bucket
export AMI_ID="ami-CHANGEME"                     # your prebuilt overlap/R AMI id
export INSTANCE_TYPE="r6i.2xlarge"               # 64 GB; matches the seam gate
export KEY_PATH="$HOME/.ssh/CHANGEME.pem"        # path to your EC2 SSH private key
export KEY_NAME="CHANGEME-key"                   # the EC2 key-pair NAME in your account
export IAM_PROFILE="CHANGEME-ec2-profile"        # IAM instance profile granting S3 access
export SG_NAME="CHANGEME-sg"                     # security group (opened only to your IP/32)
